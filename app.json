{
  "expo": {
    "name": "Urban Sprout",
    "slug": "urban-sprout",
    "scheme": "urbansprout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ankhosting.urbansprout",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ankhosting.urbansprout",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-build-properties",
        {}
      ],
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Urban Sprout uses your photos to add pictures to your garden journal and listings.",
          "cameraPermission": "Urban Sprout uses the camera to photograph your plants.",
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "REPLACE_WITH_ADMOB_ANDROID_APP_ID"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E8F5E9"
        }
      ],
      "./plugins/with-release-signing.js",
      "./plugins/with-no-test-admob.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
