# Supabase (Project Settings > API). The anon key is safe in the client; RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# RevenueCat public Google Play SDK key (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_REPLACE_ME
# AdMob banner unit id (ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ). Leave empty => NO ad is shown in release builds
# (Google test ids are used only in __DEV__ builds).
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
# AdMob app id (ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY), read by app.config.js. REQUIRED for the EAS production profile.
ADMOB_ANDROID_APP_ID=
# Set to "false" to disable ads entirely
EXPO_PUBLIC_ADS_ENABLED=true
# LOCAL DEVELOPMENT ONLY: allow Google test AdMob ids (ignored/rejected for the EAS production profile). Never set in release builds.
# ADMOB_ALLOW_TEST_IDS=true
