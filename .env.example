# Copy to .env (gitignored) before a local release build. Expo inlines EXPO_PUBLIC_* at bundle time.
# Without a real .env, the app shows "Supabase is not configured".
# Supabase (Project Settings > API). Use the anon/publishable key only — never the service_role key. RLS protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# RevenueCat public Google Play SDK key (starts with goog_)
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_REPLACE_ME
# AdMob banner unit id. Leave empty to use Google's TEST banner id.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
# Set to "false" to disable ads entirely
EXPO_PUBLIC_ADS_ENABLED=true
