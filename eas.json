{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "env": { "ADMOB_ALLOW_TEST_IDS": "true", "NODE_ENV": "development" } },
    "preview": { "distribution": "internal", "android": { "buildType": "apk" } },
    "production": { "android": { "buildType": "app-bundle" } }
  },
  "submit": {
    "production": { "android": { "track": "internal", "serviceAccountKeyPath": "./play-service-account.json" } }
  }
}
